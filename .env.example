# Copy to .env (git and docker ignore it; never commit a real key).
#   cp .env.example .env
#
# LLM -- read only by apps/api/orchestrator.py (CLAUDE.md section 7).
# Blank = deterministic template mode: explanations and the Bolt copilot still work.
# Key format: sk-ant-api03-...  Create one at https://console.anthropic.com/settings/keys
# Check it is picked up without exposing it:
#   python -c "from apps.api.orchestrator import llm_status; print(llm_status())"
#   python -c "from apps.api.orchestrator import llm_ping; print(llm_ping())"   # one tiny live call
#   GET /system/health -> "llm": {"mode": "llm" | "template", "model": ...}
# Provider: auto = OpenAI if OPENAI_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set,
# else deterministic template mode. Pin with anthropic | openai.
LLM_PROVIDER=auto

# Anthropic (Messages API). Key format: sk-ant-api03-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI Platform. Key format: sk-proj-... or sk-...  https://platform.openai.com/api-keys
# Used for the route call, the explanation draft and the Bolt tool loop when it is the active
# provider. Needs a key with model-inference (write) permission, not a read-only key.
# Set OPENAI_MODEL to a model your account can use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Storage (compose overrides these for the containers)
DATABASE_URL=sqlite:///./thor.db
MLFLOW_TRACKING_URI=./mlruns
MQTT_BROKER_URL=mqtt://localhost:1883
CHROMA_PATH=./.chroma
MANUALS_DIR=./data/manuals
MODELS_DIR=./models

# Replay speed: 1 = realtime, 1800 = thirty minutes of plant time per second (30 days in 24 min).
# The API seeds the first SEED_FRACTION of history; the replay streams from REPLAY_START_FRACTION.
REPLAY_SPEED=1800
SEED_FRACTION=0.80
REPLAY_START_FRACTION=0.80
