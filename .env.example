# Copy to .env — docker compose reads this automatically.
# LLM: only apps/api/orchestrator.py reads this. Leave blank to run in deterministic-template mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Storage (compose overrides these for the containers)
DATABASE_URL=sqlite:///./thor.db
MLFLOW_TRACKING_URI=./mlruns
MQTT_BROKER_URL=mqtt://localhost:1883
CHROMA_PATH=./.chroma
MANUALS_DIR=./data/manuals
MODELS_DIR=./models

# Replay speed: 1 = realtime, 600 = ten minutes of telemetry per second
REPLAY_SPEED=600
